{
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "build",
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "declaration": true
    },
    "include": ["src/**/*"],
    "ts-node": {
        "transpileOnly": true,
        "files": true,
        "experimentalResolver": true
    }
}
