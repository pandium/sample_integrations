{
    "name": "pandium/sb2gorgias",
    "description": "ShipBob to Gorgias sample integration.",
    "type": "project",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.10",
        "monolog/monolog": "^3.10",
        "vlucas/phpdotenv": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pandium\\Integration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pandium\\Integration\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
