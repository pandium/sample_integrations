{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["src/**/*"]
}
