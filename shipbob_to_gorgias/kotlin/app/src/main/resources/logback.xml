<configuration>
    <!--
      Logs go to stderr. Pandium reads the last non-empty line of stdout as the tenant
      metadata, so keeping logs off stdout means nothing logged after updateMetadata can
      displace it. ConsoleAppender defaults to System.out, hence the target below.
    -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set LOG_LEVEL (e.g. to DEBUG) to change verbosity without rebuilding. -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
